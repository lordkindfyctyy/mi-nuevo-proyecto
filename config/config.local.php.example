<?php

/**
 * Plantilla opcional de overrides locales/de producción.
 *
 * Copia este archivo como `config/config.local.php` (ese nombre está en
 * .gitignore, así que nunca se sube a git) SOLO si necesitas:
 *
 *  - Personalizar tu entorno local (otro usuario/clave de MySQL, otro
 *    puerto, etc.), o
 *  - Configurar producción en un hosting (como Hostinger) que no permita
 *    definir variables de entorno para PHP.
 *
 * Si tu hosting sí permite variables de entorno, es preferible usarlas
 * (ver README_DESPLIEGUE.md) y dejar este archivo sin crear.
 *
 * Deja en null (o quita la línea) cualquier clave que no quieras
 * sobreescribir; config.php usará el valor por defecto o la variable de
 * entorno correspondiente.
 */

return [
    'APP_NAME' => null,
    'APP_BASE_URL' => null, // Ej: 'https://tudominio.com'
    'DB_HOST' => null,      // Ej: 'localhost'
    'DB_NAME' => null,      // Ej: 'u123456789_minuevoproyecto'
    'DB_USER' => null,      // Ej: 'u123456789_admin'
    'DB_PASS' => null,

    // Comando de voz por IA (public/vender.php + api/procesar_comando_voz.php).
    // Conseguí una clave gratuita en https://aistudio.google.com/apikey
    'AI_VOICE_PROVIDER' => null, // Por ahora solo 'gemini' está implementado.
    'AI_VOICE_API_KEY' => null,  // Ej: 'AIza...'
    'AI_VOICE_MODEL' => null,    // Ej: 'gemini-2.0-flash' (valor por defecto si se deja null)
];
